{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["node"]
    ,"baseUrl": "."
    ,"paths": {
      "pi-mcp-adapter": ["src/pi-mcp-adapter-shim.d.ts"],
      "pi-mcp-adapter/types": ["src/pi-mcp-adapter-shim.d.ts"]
    }
  },
  "include": ["src", "scripts"]
}
